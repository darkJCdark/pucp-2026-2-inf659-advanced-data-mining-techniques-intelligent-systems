/S/Span<</ActualText(\040\\small\040&\\phi\040_2\(I^{eval}\)<\\phi\040_1\(I^{eval}\)\\\\\040&\\iff\040\\frac\040{D_{inter}^2\(I^{eval}\)}{D_{intra}^2\(I^{eval}\)}<\\frac\040{D_{inter}^1\(I^{eval}\)}{D_{intra}^1\(I^{eval}\)}\040\\\\\040&\\iff\040\\frac\040{D_{inter}^2\(I^{eval}\)}{PD_{intra}^2\(I^{pre}\)+\(1-P\)D_{inter}^2\(I^{pre}\)}<\\frac\040{D_{inter}^1\(I^{eval}\)}{PD_{intra}^1\(I^{pre}\)+\(1-P\)D_{inter}^1\(I^{pre}\)},\040\\\\\040&\\iff\040P\040<\040\\frac\040{\\frac\040{D_{inter}^1\(I^{eval}\)}{D_{inter}^1\(I^{pre}\)}-\\frac\040{D_{inter}^2\(I^{eval}\)}{D_{inter}^2\(I^{pre}\)}}{\\frac\040{D_{inter}^1\(I^{eval}\)}{D_{inter}^1\(I^{pre}\)}\\cdot\040\\left\040\(1-\\frac\040{D_{intra}^2\(I^{pre}\)}{D_{inter}^2\(I^{pre}\)}\\right\040\)-\\frac\040{D_{inter}^2\(I^{eval}\)}{D_{inter}^2\(I^{pre}\)}\\cdot\040\\left\040\(1-\\frac\040{D_{intra}^1\(I^{pre}\)}{D_{inter}^1\(I^{pre}\)}\\right\040\)},\040\\\\\040&\\iff\040P\040<\040\\frac\040{\\psi\040\(\\phi\040^{-1}_1\(I^{pre}\)\)-\\psi\040\(\\phi\040^{-1}_2\(I^{pre}\)\)}{\\psi\040\(\\phi\040^{-1}_1\(I^{pre}\)\)\\left\040\(1-\\phi\040_2^{-1}\(I^{pre}\)\\right\040\)-\\psi\040\(\\phi\040^{-1}_2\(I^{pre}\)\)\\left\040\(1-\\phi\040_1^{-1}\(I^{pre}\)\\right\040\)},\040\\\\\040&\\iff\040P<\\frac\040{1}{1-\\phi\040^{-1}_1\(I^{pre}\)+\\frac\040{\\phi\040_2^{-1}\(I^{pre}\)-\\phi\040_1^{-1}\(I^{pre}\)}{\\psi\040\(\\phi\040_2^{-1}\(I^{pre}\)\)-\\psi\040\(\\phi\040_1^{-1}\(I^{pre}\)\)}\\psi\040\(\\phi\040^{-1}_1\(I^{pre}\)\)},\040\\\\\040&\\iff\040P<\\frac\040{1}{1-\\phi\040^{-1}_1\(I^{pre}\)+r\\psi\040\(\\phi\040^{-1}_1\(I^{pre}\)\)},\040\\\\\040&\\iff\040r\\psi\040\(\\phi\040^{-1}_1\(I^{pre}\)\)\040-\040\\phi\040^{-1}_1\(I^{pre}\)\040<\040P^{-1}-1,\040\\\\\040&\\iff\040\\frac\040{d\\phi\040^{-1}_1\(I^{pre}\)}{d\\psi\040\(\\phi\040^{-1}_1\(I^{pre}\)\)}\\psi\040\(\\phi\040^{-1}_1\(I^{pre}\)\)-\\phi\040^{-1}_1\(I^{pre}\)\040<\040P^{-1}\\!-\\!1,\040\\\\\040\\label\040{eq:derive_relation}\040&\\iff\040\\frac\040{d\\phi\040^{-1}\(I^{pre}\)}{